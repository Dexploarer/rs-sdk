{
	"name": "runelight",
	"version": "0.1.0",
	"type": "module",
	"description": "RuneLight — RS-SDK Desktop Client",
	"scripts": {
		"start": "vite build && concurrently --kill-others \"bun run server:engine\" \"bun run server:gateway\" \"bun run server:webclient\" \"bun run app\"",
		"app": "electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"server:engine": "cd ../server/engine && bun run src/app.ts",
		"server:gateway": "cd ../server/gateway && bun run gateway.ts",
		"server:webclient": "cd ../server/webclient && bun --watch run bundle.ts dev",
		"build:canary": "vite build && electrobun build --env=canary"
	},
	"dependencies": {
		"electrobun": "1.16.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"concurrently": "^9.1.0",
		"solid-js": "^1.9.3",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vite-plugin-solid": "^2.11.0"
	}
}
